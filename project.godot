; Engine configuration file.
; It's best edited using the editor.

config_version=5

[application]
config/name="Mech Assault Hangar UI"
run/main_scene="res://scenes/HangarScreen.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=430
window/size/viewport_height=932
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/resizable=false
window/size/window_width_override=430
window/size/window_height_override=932

[rendering]
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
